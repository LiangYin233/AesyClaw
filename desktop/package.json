{
  "name": "aesyclaw-desktop",
  "author": "AesyClaw",
  "version": "2026.6.2",
  "description": "AesyClaw Desktop — Electron 桌面客户端",
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder"
  },
  "dependencies": {
    "marked": "^18.0.4",
    "vue": "^3.5.35",
    "vue-router": "^4.5.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "^42.3.1",
    "electron-builder": "26.8.1",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  },
  "build": {
    "electronVersion": "42.3.1",
    "appId": "com.aesyclaw.desktop",
    "productName": "AesyClaw Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "assets/icon.png"
    ],
    "icon": "assets/icon.png",
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
